<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_player"
            android:textColor="@color/sportiv_gold"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface_dark"
            android:padding="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_xs">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_hw_accel"
                android:textColor="@color/text_primary_dark" />

            <Switch
                android:id="@+id/settings_hw_accel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface_dark"
            android:padding="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_xs">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_auto_reconnect"
                android:textColor="@color/text_primary_dark" />

            <Switch
                android:id="@+id/settings_auto_reconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface_dark"
            android:padding="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_xs">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_buffer_size"
                android:textColor="@color/text_primary_dark"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <SeekBar
                android:id="@+id/settings_buffer_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="60"
                android:progress="30" />

            <TextView
                android:id="@+id/settings_buffer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sportiv_gold"
                android:textSize="@dimen/text_sm" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_audio"
            android:textColor="@color/sportiv_gold"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface_dark"
            android:padding="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_xs">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_external_audio"
                    android:textColor="@color/text_primary_dark" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تجريبي - استخدم بحذر"
                    android:textColor="@color/warning_orange"
                    android:textSize="@dimen/text_xs" />
            </LinearLayout>

            <Switch
                android:id="@+id/settings_external_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_about"
            android:textColor="@color/sportiv_gold"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <TextView
            android:id="@+id/settings_about_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_dark"
            android:padding="@dimen/spacing_md"
            android:textColor="@color/text_secondary_dark"
            android:textSize="@dimen/text_sm" />

    </LinearLayout>
</ScrollView>
