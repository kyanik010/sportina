<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:focusable="true"
    android:clickable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/surface_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="9dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:background="@drawable/bg_login_field">

            <ImageView
                android:id="@+id/grid_channel_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_channel_placeholder"
                android:contentDescription="@string/channel_logo_description" />

            <ImageButton
                android:id="@+id/grid_channel_favorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_login_field"
                android:padding="8dp"
                android:src="@drawable/ic_star_outline"
                android:tint="@color/sportiv_gold"
                android:contentDescription="@string/fav_add"
                android:focusable="true"
                android:clickable="true" />
        </FrameLayout>

        <TextView
            android:id="@+id/grid_channel_name"
            style="@style/ChannelCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="2"
            android:minLines="2"
            android:ellipsize="end"
            android:paddingTop="10dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp" />

        <TextView
            android:id="@+id/grid_channel_category"
            style="@style/ChannelCardCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>