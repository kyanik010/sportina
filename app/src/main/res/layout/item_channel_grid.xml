<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:focusable="true"
    android:clickable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="17dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/surface_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="9dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:background="@drawable/bg_channel_tile">
            <ImageView
                android:id="@+id/grid_channel_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:padding="17dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_channel_placeholder"
                android:contentDescription="@string/channel_logo_description" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_gravity="top|start"
                android:layout_margin="7dp"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:background="@drawable/bg_live_pill"
                android:text="@string/live_badge"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold" />
            <ImageButton
                android:id="@+id/grid_channel_favorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="5dp"
                android:background="@drawable/bg_login_field"
                android:padding="8dp"
                android:src="@drawable/ic_star_outline"
                android:tint="@color/sportiv_gold"
                android:contentDescription="@string/fav_add"
                android:focusable="true"
                android:clickable="true" />
        </FrameLayout>

        <TextView
            android:id="@+id/grid_channel_name"
            style="@style/ChannelCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="2"
            android:minLines="2"
            android:ellipsize="end"
            android:paddingTop="10dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp" />
        <TextView
            android:id="@+id/grid_channel_category"
            style="@style/ChannelCardCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingTop="3dp"
            android:paddingBottom="4dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
