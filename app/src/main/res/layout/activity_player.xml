<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Video player -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        app:resize_mode="fit"
        app:use_controller="false"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <!-- Loading progress -->
    <ProgressBar
        android:id="@+id/loading_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminateTint="@color/sportiv_gold" />

    <!-- Error display -->
    <LinearLayout
        android:id="@+id/error_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/error_red"
            android:textSize="@dimen/text_md"
            android:visibility="gone"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_error_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/retry"
            android:visibility="gone"
            android:layout_marginTop="@dimen/spacing_md" />
    </LinearLayout>

    <!-- Controls overlay -->
    <LinearLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/overlay_scrim"
        android:padding="@dimen/spacing_md"
        android:visibility="gone">

        <!-- Channel info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_sm">

            <TextView
                android:id="@+id/channel_name_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold"
                tools:text="beIN SPORTS 1 HD"
                xmlns:tools="http://schemas.android.com/tools" />

            <!-- Favorite toggle -->
            <ImageButton
                android:id="@+id/btn_favorite"
                android:layout_width="@dimen/player_control_height"
                android:layout_height="@dimen/player_control_height"
                android:background="?android:attr/selectableItemBackground"
                android:src="@drawable/ic_star_outline"
                android:contentDescription="@string/fav_add" />
        </LinearLayout>

        <!-- EPG info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_sm">

            <TextView
                android:id="@+id/epg_now_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/sportiv_gold"
                android:textSize="@dimen/text_sm"
                tools:text="الآن: مباراة الأهلي vs الزمالك" />

            <TextView
                android:id="@+id/epg_next_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary_dark"
                android:textSize="@dimen/text_sm" />
        </LinearLayout>

        <!-- Audio sync controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_sm">

            <TextView
                android:labelFor="@id/audio_offset_seekbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_audio_offset"
                android:textColor="@color/text_secondary_dark"
                android:textSize="@dimen/text_xs" />

            <SeekBar
                android:id="@+id/audio_offset_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="gone"
                android:max="2000"
                android:progress="1000" />

            <TextView
                android:id="@+id/audio_offset_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sportiv_gold"
                android:textSize="@dimen/text_xs"
                android:visibility="gone"
                android:text="0ms" />
        </LinearLayout>

        <!-- Control buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_prev_channel"
                android:layout_width="@dimen/player_control_height"
                android:layout_height="@dimen/player_control_height"
                android:background="?android:attr/selectableItemBackground"
                android:src="@drawable/ic_prev_channel"
                android:contentDescription="@string/player_prev_channel" />

            <ImageButton
                android:id="@+id/btn_channel_list"
                android:layout_width="@dimen/player_control_height"
                android:layout_height="@dimen/player_control_height"
                android:background="?android:attr/selectableItemBackground"
                android:src="@drawable/ic_channel_list"
                android:contentDescription="@string/player_channels_list" />

            <ImageButton
                android:id="@+id/btn_audio_sync"
                android:layout_width="@dimen/player_control_height"
                android:layout_height="@dimen/player_control_height"
                android:background="?android:attr/selectableItemBackground"
                android:src="@drawable/ic_audio_sync"
                android:contentDescription="@string/player_audio_sync" />

            <ImageButton
                android:id="@+id/btn_reconnect"
                android:layout_width="@dimen/player_control_height"
                android:layout_height="@dimen/player_control_height"
                android:background="?android:attr/selectableItemBackground"
                android:src="@drawable/ic_reconnect"
                android:contentDescription="@string/player_reconnect" />

            <ImageButton
                android:id="@+id/btn_next_channel"
                android:layout_width="@dimen/player_control_height"
                android:layout_height="@dimen/player_control_height"
                android:background="?android:attr/selectableItemBackground"
                android:src="@drawable/ic_next_channel"
                android:contentDescription="@string/player_next_channel" />
        </LinearLayout>
    </LinearLayout>

    <!-- Channel list side panel -->
    <LinearLayout
        android:id="@+id/channel_list_panel"
        android:layout_width="@dimen/player_channel_list_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/overlay_scrim"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/player_channels_list"
            android:textColor="@color/sportiv_gold"
            android:textSize="@dimen/text_md"
            android:textStyle="bold"
            android:padding="@dimen/spacing_md" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channel_list_rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/spacing_md" />
    </LinearLayout>

</FrameLayout>
