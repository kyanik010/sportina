<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SPORTIVTV  •  PREMIUM IPTV"
            android:textColor="@color/sportiv_gold"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_title"
            android:textColor="@color/text_primary_dark"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_subtitle"
            android:textColor="@color/text_secondary_dark"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_welcome_panel"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_credentials_title"
                android:textColor="@color/sportiv_gold"
                android:textStyle="bold"
                android:textSize="17sp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sub_name"
                android:textColor="@color/text_secondary_dark"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/edit_sub_name"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="@string/login_name_hint"
                android:textColorHint="@color/text_hint_dark"
                android:textColor="@color/text_primary_dark"
                android:singleLine="true"
                android:inputType="textCapSentences"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_login_field"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_server_label"
                android:textColor="@color/text_secondary_dark"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/edit_sub_url"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="@string/login_server_hint"
                android:textColorHint="@color/text_hint_dark"
                android:textColor="@color/text_primary_dark"
                android:singleLine="true"
                android:inputType="textUri"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_login_field"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_account_label"
                android:textColor="@color/text_secondary_dark"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/edit_sub_username"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="@string/sub_username"
                android:textColorHint="@color/text_hint_dark"
                android:textColor="@color/text_primary_dark"
                android:singleLine="true"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_login_field"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/edit_sub_password"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="@string/sub_password"
                android:textColorHint="@color/text_hint_dark"
                android:textColor="@color/text_primary_dark"
                android:singleLine="true"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_login_field"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_m3u_label"
                android:textColor="@color/text_secondary_dark"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/edit_sub_epg_url"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="@string/login_epg_hint"
                android:textColorHint="@color/text_hint_dark"
                android:textColor="@color/text_primary_dark"
                android:singleLine="true"
                android:inputType="textUri"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_login_field"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sub_save"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/login_connect_button"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/background_dark"
                android:backgroundTint="@color/sportiv_gold"
                app:cornerRadius="14dp" />

            <ProgressBar
                android:id="@+id/sub_progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/sportiv_gold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_privacy_note"
                android:textColor="@color/text_hint_dark"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_saved_title"
            android:textColor="@color/sportiv_gold"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/subscriptions_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/sub_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sub_no_subscriptions"
            android:textColor="@color/text_secondary_dark"
            android:textSize="13sp"
            android:visibility="gone"
            android:gravity="center"
            android:padding="20dp" />
    </LinearLayout>
</ScrollView>