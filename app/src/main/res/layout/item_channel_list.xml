<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_sm"
    android:background="@drawable/channel_list_item_bg"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/channel_item_logo"
        android:layout_width="@dimen/channel_logo_size"
        android:layout_height="@dimen/channel_logo_size"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_channel_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_sm"
        android:orientation="vertical">

        <TextView
            android:id="@+id/channel_item_name"
            style="@style/ChannelCardTitle" />

        <TextView
            android:id="@+id/channel_item_category"
            style="@style/ChannelCardCategory" />
    </LinearLayout>
</LinearLayout>
