<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_dark"
    android:padding="@dimen/spacing_md"
    android:layout_margin="@dimen/spacing_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sub_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary_dark"
            android:textSize="@dimen/text_md"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sub_item_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/sportiv_green"
            android:textSize="@dimen/text_sm" />
    </LinearLayout>

    <TextView
        android:id="@+id/sub_item_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary_dark"
        android:textSize="@dimen/text_xs"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginTop="@dimen/spacing_xs" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/spacing_sm">

        <Button
            android:id="@+id/sub_item_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sub_test"
            android:textSize="@dimen/text_xs" />

        <Button
            android:id="@+id/sub_item_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sub_delete"
            android:textColor="@color/error_red"
            android:textSize="@dimen/text_xs"
            android:layout_marginStart="@dimen/spacing_sm" />
    </LinearLayout>

</LinearLayout>
