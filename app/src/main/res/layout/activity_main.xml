<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark">

    <!-- Search bar -->
    <EditText
        android:id="@+id/search_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search_hint"
        android:textColorHint="@color/text_hint_dark"
        android:textColor="@color/text_primary_dark"
        android:background="@color/surface_dark"
        android:padding="@dimen/spacing_md"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="@dimen/spacing_sm"
        android:inputType="text"
        android:imeOptions="actionSearch" />

    <!-- Category tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/category_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabTextColor="@color/text_secondary_dark"
        app:tabSelectedTextColor="@color/sportiv_gold"
        app:tabIndicatorColor="@color/sportiv_gold"
        app:tabMode="scrollable"
        android:background="@color/surface_dark" />

    <!-- Content area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channels_rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/spacing_sm" />

        <ProgressBar
            android:id="@+id/loading_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/sportiv_gold" />

        <LinearLayout
            android:id="@+id/empty_state_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/spacing_lg"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_welcome_panel"
            android:padding="@dimen/spacing_xl"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_nav_subscriptions"
                android:contentDescription="@string/welcome_add_subscription"
                android:tint="@color/sportiv_gold"
                android:layout_marginBottom="@dimen/spacing_md" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome_title"
                android:textColor="@color/text_primary_dark"
                android:textSize="@dimen/text_xxl"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <TextView
                android:id="@+id/empty_state_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome_empty_description"
                android:textColor="@color/text_secondary_dark"
                android:textSize="@dimen/text_md"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/empty_state_action"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/welcome_add_subscription"
                android:textStyle="bold"
                android:textColor="@color/background_dark"
                android:backgroundTint="@color/sportiv_gold"
                app:cornerRadius="16dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome_supported_formats"
                android:textColor="@color/text_hint_dark"
                android:textSize="@dimen/text_xs"
                android:gravity="center"
                android:layout_marginTop="@dimen/spacing_md" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:itemTextColor="@color/sportiv_gold"
        app:itemIconTint="@color/sportiv_gold"
        android:background="@color/surface_dark" />

</LinearLayout>
