<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_sm"
        android:background="@color/surface_dark">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/browse_brand"
                    android:textColor="@color/sportiv_gold"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:letterSpacing="0.14" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/browse_title"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold"
                    android:textSize="24sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/channel_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sportiv_gold"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_login_field" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            app:boxBackgroundMode="filled"
            app:boxBackgroundColor="@color/card_dark"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/sportiv_gold"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/sportiv_gold"
            app:hintEnabled="false">

            <EditText
                android:id="@+id/search_edit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="@string/search_hint"
                android:textColorHint="@color/text_hint_dark"
                android:textColor="@color/text_primary_dark"
                android:background="@android:color/transparent"
                android:paddingStart="4dp"
                android:paddingEnd="12dp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/category_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabTextColor="@color/text_secondary_dark"
        app:tabSelectedTextColor="@color/sportiv_gold"
        app:tabIndicatorColor="@color/sportiv_gold"
        app:tabIndicatorHeight="3dp"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabRippleColor="@color/card_dark_pressed"
        android:background="@color/surface_dark" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channels_rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_md"
            android:scrollbars="vertical"
            android:overScrollMode="ifContentScrolls" />

        <ProgressBar
            android:id="@+id/loading_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/sportiv_gold" />

        <LinearLayout
            android:id="@+id/empty_state_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/spacing_lg"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_welcome_panel"
            android:padding="@dimen/spacing_xl"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_nav_subscriptions"
                android:contentDescription="@string/welcome_add_subscription"
                android:tint="@color/sportiv_gold"
                android:layout_marginBottom="@dimen/spacing_md" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome_title"
                android:textColor="@color/text_primary_dark"
                android:textSize="@dimen/text_xxl"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <TextView
                android:id="@+id/empty_state_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome_empty_description"
                android:textColor="@color/text_secondary_dark"
                android:textSize="@dimen/text_md"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/empty_state_action"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/welcome_add_subscription"
                android:textStyle="bold"
                android:textColor="@color/background_dark"
                android:backgroundTint="@color/sportiv_gold"
                app:cornerRadius="16dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome_supported_formats"
                android:textColor="@color/text_hint_dark"
                android:textSize="@dimen/text_xs"
                android:gravity="center"
                android:layout_marginTop="@dimen/spacing_md" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:itemTextColor="@color/sportiv_gold"
        app:itemIconTint="@color/sportiv_gold"
        app:labelVisibilityMode="labeled"
        android:background="@color/surface_dark" />
</LinearLayout>