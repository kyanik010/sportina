<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base theme - Dark, RTL-ready, Arabic-first -->
    <style name="Theme.SportivTV" parent="Theme.Material3.Dark.NoActionBar">
        <!-- RTL support -->
        <item name="android:layoutDirection" tools:targetApi="17">rtl</item>

        <!-- Colors -->
        <item name="colorPrimary">@color/sportiv_gold</item>
        <item name="colorPrimaryVariant">@color/sportiv_gold_dark</item>
        <item name="colorSecondary">@color/sportiv_green</item>
        <item name="colorSecondaryVariant">@color/sportiv_green_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorBackground">@color/background_dark</item>
        <item name="colorError">@color/error_red</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>

        <!-- Window animation -->
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <!-- Player theme - fullscreen, no chrome -->
    <style name="Theme.SportivTV.Player" parent="Theme.SportivTV">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <!-- TV theme using Leanback -->
    <style name="Theme.SportivTV.TV" parent="Theme.Leanback">
        <item name="android:layoutDirection" tools:targetApi="17">rtl</item>
        <item name="colorPrimary">@color/sportiv_gold</item>
        <item name="android:colorBackground">@color/background_dark</item>
    </style>

    <!-- Channel card text -->
    <style name="ChannelCardTitle">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ChannelCardCategory">
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textColor">@color/text_secondary_dark</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- EPG text -->
    <style name="EpgTitle">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/text_primary_dark</item>
    </style>

    <style name="EpgTime">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/sportiv_gold</item>
    </style>
</resources>
